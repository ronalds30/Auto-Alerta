{
  "expo": {
    "name": "AutoAlerta",
    "slug": "AutoAlerta",
    "scheme": "autoalerta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1628"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tsspty.autoalerta"
    },
    "android": {
      "package": "com.tsspty.autoalerta",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1628"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "AutoAlerta necesita acceso a la cámara para capturar fotos de documentos (cédulas, licencias, pólizas, registros) y vehículos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AutoAlerta necesita acceso a tus fotos para adjuntar documentos y vehículos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF6F00",
          "defaultChannel": "default"
        }
      ],
      "expo-font",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2e2bb015-9a08-4a11-86c2-a3748613340a"
      },
      "googleAndroidClientId": "856777328728-qb8lhpoe1lvm7mo750h66bm5v05gj7uj.apps.googleusercontent.com",
      "googleWebClientId": "856777328728-qnbm8rd92jtm2hqsa5f15226r60nrnf7.apps.googleusercontent.com"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2e2bb015-9a08-4a11-86c2-a3748613340a"
    }
  }
}
