# AutoAlerta - Variables de entorno
# Copia este archivo a .env y reemplaza con tus credenciales reales.
# Estas son LEIDAS por Expo en build/runtime. No las commits al repositorio.

# OAuth Google (creados en Google Cloud Console)
# - Android: necesita SHA-1 del keystore + package "com.tsspty.autoalerta"
# - iOS: opcional si no compilas para iOS
# - Web: necesario para Expo Go / web
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
